GROQ_API_KEY=paste-your-key-here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REVIEW_MODEL=openai/gpt-oss-120b

# local keeps the ChatGPT connection on this laptop; demo forces Groq only.
BEALINGO_MODE=local

# Required for the demo Render service. Must match the Vercel server-side value.
PRIVATE_PROXY_SECRET=

DEMO_ASSESSMENTS_PER_DAY=6
DEMO_LESSONS_PER_DAY=4
DEMO_COACH_QUESTIONS_PER_DAY=5

BEALINGO_FRONTEND_URL=http://127.0.0.1:5180
CHATGPT_REDIRECT_URI=http://127.0.0.1:8010/api/chatgpt/callback
